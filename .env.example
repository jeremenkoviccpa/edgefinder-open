# --- LLM: any OpenAI-compatible endpoint serving an open-weights model ---
# Local, free (Ollama):
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=hermes3:8b
# Hosted, cheap (example: Groq). Same API, just swap these three:
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_...
# LLM_MODEL=llama-3.1-8b-instant

# --- Optional data credentials ---
# Free key: https://fred.stlouisfed.org/docs/api/api_key.html (more reliable than keyless CSV)
FRED_API_KEY=
# Free Myfxbook account -> retail FX positioning (Community Outlook API)
MYFXBOOK_EMAIL=
MYFXBOOK_PASSWORD=

# --- API server (Railway) ---
EF_SCHEDULE_HOURS=12,17,2
EF_ADMIN_TOKEN=
EF_CORS_ORIGINS=*
